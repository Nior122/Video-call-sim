# OpenAI-compatible AI Providers (Groq, OpenRouter, OpenAI)
# You only need to set ONE of these:

# 1. Groq (Fast & Free Tier Available)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. OpenRouter (Access any open-source or commercial model)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# 3. OpenAI (Direct OpenAI or compatible proxy)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Database
DATABASE_URL="file:./dev.db"

# Admin Secret
ADMIN_SECRET="admin_secret_123"

# App Info
APP_URL=""
